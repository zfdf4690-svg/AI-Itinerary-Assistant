# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEEPSEEK_API_KEY: Optional DeepSeek API key for LLM-powered natural language schedule parsing.
# Configure this if you wish to use DeepSeek-V3 or DeepSeek-R1.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# MINIMAX_API_KEY & MINIMAX_GROUP_ID: Optional MiniMax Speech-01 voice synthesis & ASR integration.
# Configure this if you wish to use MiniMax ultra-realistic voice models.
MINIMAX_API_KEY=""
MINIMAX_GROUP_ID=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
