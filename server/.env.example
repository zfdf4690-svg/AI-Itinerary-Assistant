# ===== AI 语音行程助手 后端环境变量 =====
# 复制为 .env 后按需修改；未配置时使用内置默认值。

# 服务端口
PORT=4000

# 数据目录（相对 server/ 目录；JSON 文件持久化）
DATA_DIR=./data

# 允许跨域的前端来源（逗号分隔）
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ===== LLM（OpenAI 兼容协议，默认 DeepSeek）=====
# 用于自然语言日程解析的智能通道；未配置或调用失败时自动降级为本地规则 NLU。
LLM_ENABLED=false
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ===== MiniMax（TTS 语音合成 / ASR 语音识别）=====
# 语音反馈与语音输入代理；未配置时返回明确的“未配置”状态，前端可回退浏览器语音能力。
MINIMAX_ENABLED=false
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-01-turbo
MINIMAX_ASR_MODEL=asr-01
